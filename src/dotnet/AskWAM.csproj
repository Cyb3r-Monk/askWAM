<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>askwam</AssemblyName>
    <RootNamespace>AskWam</RootNamespace>
    <WindowsSdkVersion Condition="'$(WindowsSdkVersion)' == ''">10.0.26100.0</WindowsSdkVersion>
    <WindowsMetadataPath Condition="'$(WindowsMetadataPath)' == ''">$(MSBuildProgramFiles32)\Windows Kits\10\UnionMetadata\$(WindowsSdkVersion)\Windows.winmd</WindowsMetadataPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <Reference Include="System.Runtime.WindowsRuntime">
      <HintPath>$(WINDIR)\Microsoft.NET\Framework\v4.0.30319\System.Runtime.WindowsRuntime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Windows">
      <HintPath>$(WindowsMetadataPath)</HintPath>
      <IsWinMDFile>true</IsWinMDFile>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateWindowsMetadata" BeforeTargets="ResolveReferences" Condition="!Exists('$(WindowsMetadataPath)')">
    <Error Text="Windows SDK metadata was not found at '$(WindowsMetadataPath)'. Set WindowsMetadataPath to a Windows.winmd from an installed Windows 10 or 11 SDK." />
  </Target>
</Project>
